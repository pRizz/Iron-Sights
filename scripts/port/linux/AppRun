#!/bin/sh
set -eu
appdir=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
data_root=${GE_DATA_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/iron-sights}
case "$data_root" in
    /*) ;;
    *) printf '%s\n' 'Iron Sights: the writable data root must be absolute.' >&2; exit 1 ;;
esac
mkdir -p "$data_root/Data"
# Seed only packaged defaults. Never replace existing settings or player data.
for file in gamecontrollerdb.txt gamecontrollerdefault.txt midas_ini_help.txt; do
    if [ ! -e "$data_root/$file" ]; then cp "$appdir/$file" "$data_root/$file"; fi
done
if [ ! -e "$data_root/Data/shaders_base.txt" ]; then
    cp "$appdir/Data/shaders_base.txt" "$data_root/Data/shaders_base.txt"
fi
export GE_DATA_ROOT="$data_root"
export LD_LIBRARY_PATH="$appdir/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$appdir/IronSights" "$@"
