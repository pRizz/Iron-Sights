#!/bin/sh
set -eu
appdir=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
data_root=${GE_DATA_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/iron-sights}
case "$data_root" in
    /*) ;;
    *) printf '%s\n' 'Iron Sights: the writable data root must be absolute.' >&2; exit 1 ;;
esac
mkdir -p "$data_root/Data"
# Seed the controller files only when missing: a player may edit them. Never
# replace existing settings or player data.
for file in gamecontrollerdb.txt gamecontrollerdefault.txt; do
    if [ ! -e "$data_root/$file" ]; then cp "$appdir/$file" "$data_root/$file"; fi
done
# The ini help and the shader list are the package's own: refresh them when
# this AppImage carries other ones, as after an update (FORK-095).
for file in midas_ini_help.txt Data/shaders_base.txt; do
    if ! cmp -s "$appdir/$file" "$data_root/$file" 2>/dev/null; then cp "$appdir/$file" "$data_root/$file"; fi
done
export GE_DATA_ROOT="$data_root"
export LD_LIBRARY_PATH="$appdir/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$appdir/IronSights" "$@"
