{
  "name": "project-midas-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1 --port 4175",
    "build": "bun tools/build-site.ts",
    "verify:site": "bun tools/verify-site.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src tools/runtime-policy.test.ts tools/frontend-files.test.ts tools/model-geometry.test.mjs tools/audio-quality.test.mjs",
    "audit:runtime": "node tools/runtime-audit.mjs",
    "audit:menus": "node tools/menu-audit.mjs",
    "audit:launcher": "node tools/launcher-game-audit.mjs",
    "audit:room-exit": "node tools/room-exit-audit.mjs",
    "audit:control": "node tools/control-transition-audit.mjs",
    "audit:startup": "node tools/startup-audit.mjs",
    "test:startup": "node tools/startup-ui-audit.mjs",
    "test:launcher": "node tools/launcher-ui-audit.mjs",
    "test:room": "node tools/room-audit.mjs",
    "test:touch": "bun tools/build-touch-test.ts && node tools/touch-ui-audit.mjs",
    "audit:touch": "node tools/touch-game-audit.mjs",
    "audit:audio": "node tools/audio-quality-audit.mjs",
    "audit:mouse": "node tools/mouse-input-audit.mjs",
    "test:sampler": "node tools/sampler-audit.mjs",
    "test:storage": "bun tools/build-storage-test.ts && node tools/storage-audit.mjs",
    "test:filesystem": "bun tools/build-storage-test.ts && node tools/filesystem-audit.mjs"
  },
  "dependencies": {
    "mystic-ui": "github:pRizz/mystic-ui#d36017757708ed01ef2b3b47beb14f294726411c",
    "solid-js": "1.9.17",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/three": "0.186.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14"
  }
}
