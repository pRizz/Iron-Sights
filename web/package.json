{
  "name": "project-midas-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1 --port 4175",
    "build": "bun tools/build-site.ts",
    "verify:site": "bun tools/verify-site.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src tools/runtime-policy.test.ts",
    "audit:runtime": "node tools/runtime-audit.mjs",
    "audit:menus": "node tools/menu-audit.mjs",
    "audit:launcher": "node tools/launcher-game-audit.mjs",
    "test:launcher": "node tools/launcher-ui-audit.mjs",
    "test:sampler": "node tools/sampler-audit.mjs",
    "test:storage": "bun tools/build-storage-test.ts && node tools/storage-audit.mjs",
    "test:filesystem": "bun tools/build-storage-test.ts && node tools/filesystem-audit.mjs"
  },
  "dependencies": {
    "mystic-ui": "github:pRizz/mystic-ui#d36017757708ed01ef2b3b47beb14f294726411c",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14"
  }
}
